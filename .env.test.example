# Generate high-entropy values locally; never put real credentials in this example.
OATHFRONT_TEST_DATABASE=1
OATHFRONT_DB_OWNER_PASSWORD=<64-hex-characters>
OATHFRONT_DB_RUNTIME_PASSWORD=<different-64-hex-characters>
TEST_DATABASE_URL_UNPOOLED=postgresql://oathfront_migrator:<owner-password>@127.0.0.1:55432/oathfront_test
TEST_DATABASE_URL=postgresql://oathfront_runtime:<runtime-password>@127.0.0.1:55432/oathfront_test
