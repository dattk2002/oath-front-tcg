          "type": "text",
          "id": "bxCcD",
          "name": "Proposals",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": 1300,
          "content": "Proposed spacing: 8 / 16 / 24 / 32 / 48. Rectangular hit areas ≥44px. Angular art stays outside controls. Contrast, reflow and focus audit pending; decoration is not a semantic color.",
          "fontFamily": "Noto Sans",
          "fontSize": 14
        }
      ]
    },
